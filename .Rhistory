dbGetQuery(con, "PRAGMA table_info(deliveries)")
dbGetQuery(con, "
SELECT
order_id,
(julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60 AS delivery_time_minutes
FROM deliveries
WHERE (julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60 > 60
ORDER BY delivery_time_minutes DESC
")
dbGetQuery(con, "
SELECT
hub_id,
AVG((julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60) AS avg_delivery_time
FROM deliveries
GROUP BY hub_id
ORDER BY avg_delivery_time DESC
")
