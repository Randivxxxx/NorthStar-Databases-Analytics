con <- dbConnect(SQLite(), "C:/Users/anuma/Desktop/ASSIGNMENT/northstar_dataset/NorthStar.db")
dbListTables(con)
dbGetQuery(con, "
SELECT
hub_id,
AVG((julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60) AS avg_delivery_time
FROM deliveries
GROUP BY hub_id
ORDER BY avg_delivery_time DESC
")
dbGetQuery(con, "
SELECT
customer_rating_post_delivery,
COUNT(*) AS total_orders
FROM deliveries
GROUP BY customer_rating_post_delivery
ORDER BY customer_rating_post_delivery
")
dbGetQuery(con, "
WITH delivery_data AS (
SELECT
hub_id,
(julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60 AS delivery_time_minutes
FROM deliveries
WHERE delivery_completed_at IS NOT NULL
)
SELECT
hub_id,
AVG(delivery_time_minutes) AS avg_delivery_time,
COUNT(*) AS total_deliveries
FROM delivery_data
GROUP BY hub_id
ORDER BY avg_delivery_time DESC
")
dbGetQuery(con, "
SELECT
hub_id,
AVG(customer_rating_post_delivery) AS avg_rating,
COUNT(*) AS total_deliveries
FROM deliveries
WHERE customer_rating_post_delivery IS NOT NULL
GROUP BY hub_id
ORDER BY avg_rating DESC
")
dbGetQuery(con, "
WITH driver_data AS (
SELECT
driver_id,
(julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60 AS delivery_time_minutes,
customer_rating_post_delivery
FROM deliveries
WHERE delivery_completed_at IS NOT NULL
)
SELECT
driver_id,
AVG(delivery_time_minutes) AS avg_delivery_time,
AVG(customer_rating_post_delivery) AS avg_rating,
COUNT(*) AS total_deliveries
FROM driver_data
GROUP BY driver_id
ORDER BY avg_rating DESC, avg_delivery_time ASC
")
dbGetQuery(con, "
WITH hub_metrics AS (
SELECT
hub_id,
(julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60 AS delivery_time_minutes,
customer_rating_post_delivery,
fuel_or_charge_cost,
manual_route_override_count
FROM deliveries
)
SELECT
hub_id,
AVG(delivery_time_minutes) AS avg_delivery_time,
AVG(customer_rating_post_delivery) AS avg_rating,
AVG(fuel_or_charge_cost) AS avg_fuel_cost,
AVG(manual_route_override_count) AS avg_overrides,
COUNT(*) AS total_deliveries
FROM hub_metrics
GROUP BY hub_id
ORDER BY avg_rating DESC
")
library(ggplot2)
data <- dbGetQuery(con, "
SELECT
hub_id,
AVG((julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60) AS avg_delivery_time
FROM deliveries
GROUP BY hub_id
")
ggplot(data, aes(x = hub_id, y = avg_delivery_time)) +
geom_bar(stat = "identity") +
labs(title = "Delivery Delays by Hub",
x = "Hub",
y = "Avg Delivery Time (minutes)")
data <- dbGetQuery(con, "
SELECT
hub_id,
AVG(customer_rating_post_delivery) AS avg_rating
FROM deliveries
GROUP BY hub_id
")
ggplot(data, aes(x = hub_id, y = avg_rating)) +
geom_bar(stat = "identity") +
labs(title = "Customer Rating by Hub",
x = "Hub",
y = "Average Rating")
data <- dbGetQuery(con, "
SELECT
driver_id,
AVG(customer_rating_post_delivery) AS avg_rating
FROM deliveries
GROUP BY driver_id
ORDER BY avg_rating DESC
LIMIT 10
")
ggplot(data, aes(x = reorder(driver_id, avg_rating), y = avg_rating)) +
geom_bar(stat = "identity") +
coord_flip() +
labs(title = "Top 10 Driver Performance",
x = "Driver",
y = "Avg Rating")
data <- dbGetQuery(con, "
SELECT
hub_id,
AVG(customer_rating_post_delivery) AS avg_rating,
AVG((julianday(delivery_completed_at) - julianday(dispatch_time)) * 24 * 60) AS avg_time
FROM deliveries
GROUP BY hub_id
")
ggplot(data, aes(x = avg_time, y = avg_rating, label = hub_id)) +
geom_point(size = 4) +
geom_text(vjust = -1) +
labs(title = "Hub Performance (Speed vs Rating)",
x = "Avg Delivery Time",
y = "Avg Rating")
